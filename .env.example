# Chatbot AI provider — set ONE of these (Groq recommended: fast + generous free tier)
# Leave both blank and the chatbot still works, answering from a built-in
# local knowledge base instead of a live model.

# Option A (recommended): https://console.groq.com/keys — free, no card required
VITE_GROQ_API_KEY=

# Option B: https://aistudio.google.com/apikey — free tier, slower/stricter limits
VITE_GEMINI_API_KEY=
